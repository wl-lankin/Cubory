#!/bin/bash
# Tägliche Sicherung von Datenbank und Konfiguration.
#
# Läuft als root über cubory-backup.timer. Liegt hier im Repo, damit
# Änderungen nachvollziehbar bleiben - installiert wird die Datei von
# setup-backup.sh.
set -euo pipefail

ZIEL=/var/backups/cubory
DB=cubory
ENVDATEI=/etc/cubory/api.env
TAGE=14

stempel=$(date +%Y-%m-%d-%H%M)
dump="$ZIEL/$DB-$stempel.dump"

install -d -m 700 -o root -g root "$ZIEL"

# Eigenes Format (-Fc): komprimiert und erlaubt es, einzelne Tabellen
# zurückzuholen, statt nur alles auf einmal.
sudo -u postgres pg_dump -Fc "$DB" > "$dump"
chmod 600 "$dump"

# Eine Sicherung, die sich nicht lesen lässt, ist keine. pg_restore -l liest
# das Inhaltsverzeichnis und schlägt fehl, wenn die Datei beschädigt ist -
# eine reine Größenprüfung würde einen abgebrochenen Dump durchgehen lassen.
if ! eintraege=$(pg_restore -l "$dump" 2>/dev/null | grep -c '^[0-9]'); then
  echo "Sicherung $dump ist nicht lesbar - wird verworfen." >&2
  rm -f "$dump"
  exit 1
fi
if [ "$eintraege" -lt 5 ]; then
  echo "Sicherung $dump enthält nur $eintraege Einträge - das ist zu wenig." >&2
  rm -f "$dump"
  exit 1
fi

# Die Konfiguration enthält den Ed25519-Signierschlüssel. Geht der verloren,
# lässt sich keine ausgelieferte Lizenz mehr prüfen - kein Datenbank-Backup
# der Welt hilft dann weiter.
if [ -f "$ENVDATEI" ]; then
  cp -a "$ENVDATEI" "$ZIEL/api.env-$stempel"
  chmod 600 "$ZIEL/api.env-$stempel"
fi

# Ältere Sicherungen aufräumen
find "$ZIEL" -maxdepth 1 -name "$DB-*.dump" -mtime +$TAGE -delete
find "$ZIEL" -maxdepth 1 -name 'api.env-*' -mtime +$TAGE -delete

echo "Sicherung $dump ($eintraege Einträge, $(du -h "$dump" | cut -f1)) abgelegt."
