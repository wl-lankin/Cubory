#!/bin/bash
# Installiert die nach /srv/cubory-staging/ hochgeladene API-Binary, startet den
# Dienst neu und rollt zurück, falls die Health-Prüfung danach fehlschlägt.
# Läuft auf dem Server als root, aufgerufen über eine enge sudo-Regel vom
# deploy-Nutzer. Liegt hier im Repo, damit Änderungen nachvollziehbar bleiben -
# installiert wird die Datei von setup-deploy-user.sh.
set -euo pipefail

STAGING=/srv/cubory-staging/cubory-api
TARGET=/usr/local/bin/cubory-api
BACKUP=/usr/local/bin/cubory-api.prev
HEALTH=http://127.0.0.1:8880/healthz

[[ -f $STAGING ]] || { echo "Keine hochgeladene Binary unter $STAGING" >&2; exit 1; }

# Abgebrochene Uploads sind sonst erst nach dem Neustart als Problem sichtbar.
file -b "$STAGING" | grep -q 'ELF 64-bit' || {
  echo "$STAGING ist keine Linux-Binary - Upload vermutlich unvollständig" >&2
  exit 1
}

cp -a "$TARGET" "$BACKUP"
install -m 755 -o root -g root "$STAGING" "$TARGET"
rm -f "$STAGING"
systemctl restart cubory-api

# Der Dienst braucht einen Moment für Migrationen und DB-Verbindung.
for _ in $(seq 1 20); do
  sleep 1
  if curl -fsS --max-time 3 "$HEALTH" >/dev/null 2>&1; then
    echo "API antwortet - neue Version ist aktiv."
    exit 0
  fi
done

echo "Health-Prüfung fehlgeschlagen - Rollback auf die vorige Binary." >&2
install -m 755 -o root -g root "$BACKUP" "$TARGET"
systemctl restart cubory-api
sleep 3
if curl -fsS --max-time 3 "$HEALTH" >/dev/null 2>&1; then
  echo "Rollback erfolgreich, die vorige Version läuft wieder." >&2
else
  echo "ACHTUNG: Auch nach dem Rollback antwortet die API nicht!" >&2
fi
exit 1
