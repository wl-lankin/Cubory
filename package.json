{
  "name": "cubory",
  "productName": "Cubory",
  "version": "1.5.0",
  "description": "Cubory - The modern CAD viewer",
  "author": "Wolfgang Linz",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "start": "npm run build:renderer && electron .",
    "build:renderer": "vite build",
    "dist": "npm run build:renderer && electron-builder --mac --win --linux",
    "dist:mac": "npm run build:renderer && electron-builder --mac",
    "dist:win": "npm run build:renderer && electron-builder --win",
    "release:publish": "node scripts/publish-release.mjs",
    "dev:app": "node scripts/dev.mjs",
    "dist:linux": "npm run build:renderer && electron-builder --linux"
  },
  "build": {
    "appId": "de.wolfganglinz.cubory",
    "productName": "Cubory",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "fileAssociations": [
      {
        "ext": "dxf",
        "name": "DXF Drawing",
        "role": "Viewer"
      },
      {
        "ext": "dwg",
        "name": "DWG Drawing",
        "role": "Viewer"
      },
      {
        "ext": "step",
        "name": "STEP Model",
        "role": "Viewer"
      },
      {
        "ext": "stp",
        "name": "STEP Model",
        "role": "Viewer"
      },
      {
        "ext": "iges",
        "name": "IGES Model",
        "role": "Viewer"
      },
      {
        "ext": "igs",
        "name": "IGES Model",
        "role": "Viewer"
      },
      {
        "ext": "brep",
        "name": "BREP Model",
        "role": "Viewer"
      },
      {
        "ext": "stl",
        "name": "STL Mesh",
        "role": "Viewer"
      },
      {
        "ext": "obj",
        "name": "OBJ Mesh",
        "role": "Viewer"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://cubory.app/downloads"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics"
    }
  },
  "dependencies": {
    "dxf": "^4.7.0",
    "electron-updater": "^6.8.9",
    "node-machine-id": "^1.1.12",
    "occt-import-js": "^0.0.23",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/space-grotesk": "^5.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.61.1",
    "vite": "^6.0.3"
  }
}